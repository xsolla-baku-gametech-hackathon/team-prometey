# Copy to .env and adjust if needed. Not required for local (non-Docker) runs --
# the backend works with zero configuration, defaulting to ./storage and
# ./meshdiff.db in the backend/ directory.

# Where uploaded files + extracted data are stored
MESHDIFF_STORAGE_ROOT=./storage

# Where the SQLite database file lives
MESHDIFF_DB_PATH=./meshdiff.db

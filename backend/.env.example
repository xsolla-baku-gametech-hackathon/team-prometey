# Copy to backend/.env (or export directly) for anything beyond localhost.
# Neither is required to run locally -- see README's Setup section.

# Secret used to sign JWTs. MUST be a long random value outside localhost --
# the app falls back to an insecure dev-only default if this is unset.
LOOT_AUDITOR_JWT_SECRET=

# Path to the SQLite database file. Defaults to ./loot_auditor.db if unset.
LOOT_AUDITOR_DB_PATH=

# Comma-separated emails that get admin access (the /admin dashboard) the
# next time they sign up or log in. Empty/unset means no admins -- there's
# no self-serve admin role.
TRUELOOT_ADMIN_EMAILS=

# Password for the seeded demo@example.com account (run `python -m
# app.seed_demo` to create/refresh it). Defaults to "demo-loot-2026" if
# unset -- fine for a local hackathon demo, change it before deploying
# anywhere public.
TRUELOOT_DEMO_PASSWORD=
